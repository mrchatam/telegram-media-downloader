{
  "manifest_version": 3,
  "name": "Telegram Media Downloader",
  "version": "1.0.0",
  "description": "Download videos, images, and audio from Telegram Web without daily limits. Supports single and batch downloads.",
  "homepage_url": "https://github.com/mrchatam/telegram-media-downloader",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/popup.html",
    "default_title": "Telegram Media Downloader"
  },
  "host_permissions": [
    "https://web.telegram.org/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "src/page-downloader.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_end"
    }
  ]
}
